# Required. Never commit the real key.
DEEPSEEK_API_KEY=replace-with-your-key

# Optional overrides.
DEEPSEEK_BASE_URL=https://api.deepseek.com
MARKETPULSE_MODEL=deepseek-chat
MARKETPULSE_TOTAL_TIMEOUT_SECONDS=300
MARKETPULSE_MAX_SEARCH_QUERIES=12
MARKETPULSE_MAX_PAGES=24
MARKETPULSE_PAGE_TIMEOUT_SECONDS=15
MARKETPULSE_LOG_LEVEL=INFO
MARKETPULSE_API_PORT=8000
MARKETPULSE_REPORT_DIR=reports
# Set to true only when a trusted local proxy maps public DNS to 198.18.0.0/15.
MARKETPULSE_ALLOW_PROXY_DNS=false

# Four-agent blackboard. SQLite needs no background services.
MARKETPULSE_DATABASE_URL=sqlite:///data/blackboard.db
MARKETPULSE_MAX_RESEARCH_ROUNDS=2
# Optional best-effort progress notification, never a task queue.
# MARKETPULSE_REDIS_URL=redis://127.0.0.1:56379/0
# Server mode: uv sync --extra dev --extra web --extra server
# Set MARKETPULSE_PG_PASSWORD before running docker compose up -d.
# MARKETPULSE_PG_PASSWORD=choose-a-local-password
# MARKETPULSE_DATABASE_URL=postgresql+psycopg://marketpulse:URL_ENCODED_PASSWORD@127.0.0.1:55432/marketpulse

# Investigation Console / Docker Compose.
# Compose supplies a local-only fallback database password so the stack can boot,
# but set a unique value when the data volume matters.
MARKETPULSE_PG_PASSWORD=marketpulse-local

# Phase 5 single configured reviewer. Generate REVIEWER_PASSWORD_HASH with an
# Argon2id password hasher; never put the plaintext password in this file.
REVIEWER_ID=local-reviewer
REVIEWER_DISPLAY_NAME=Local reviewer
REVIEWER_PASSWORD_HASH=
REVIEW_RATE_LIMIT_FINGERPRINT_SECRET=
REVIEW_SESSION_TTL_HOURS=8
REVIEW_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REVIEW_ALLOW_INSECURE_LOOPBACK=true

# Local non-container server: search-report-api
INVESTIGATION_API_HOST=127.0.0.1
INVESTIGATION_API_PORT=8000
INVESTIGATION_BLOB_ROOT=data/investigation-blobs
