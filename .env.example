# Optional for offline replay. Required for a LIVE investigation; never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MARKETPULSE_MODEL=deepseek-flash
# Structured extraction uses non-thinking mode to reserve output tokens for JSON.
MARKETPULSE_THINKING_ENABLED=false
# Bounded investigation capacity; existing environment overrides remain authoritative.
MARKETPULSE_TOTAL_TIMEOUT_SECONDS=3600
MARKETPULSE_MAX_SEARCH_QUERIES=240
MARKETPULSE_MAX_PAGES=600
MARKETPULSE_PAGE_TIMEOUT_SECONDS=15
MARKETPULSE_MAX_RESEARCH_ROUNDS=6
MARKETPULSE_RESEARCH_WORKERS=4
MARKETPULSE_SEARCH_CONCURRENCY=4
MARKETPULSE_FETCH_CONCURRENCY=8
MARKETPULSE_QUERIES_PER_RESEARCHER=3
MARKETPULSE_MAX_MODEL_CALLS=480
MARKETPULSE_MAX_TOKENS=2000000
MARKETPULSE_LOG_LEVEL=INFO
# Only enable for a trusted local DNS proxy that maps public DNS to 198.18.0.0/15.
MARKETPULSE_ALLOW_PROXY_DNS=false

# Local development. Compose supplies its own PostgreSQL URL.
MARKETPULSE_DATABASE_URL=sqlite:///data/blackboard.db
INVESTIGATION_API_HOST=127.0.0.1
INVESTIGATION_API_PORT=8000
INVESTIGATION_BLOB_ROOT=data/investigation-blobs

# Local demo default; choose a unique URL-safe password for important data.
MARKETPULSE_PG_PASSWORD=marketpulse-local

# Optional configured reviewer. Generate Argon2id hash as described in README.
# In Compose .env, SINGLE-QUOTE the hash to preserve literal dollar signs.
REVIEWER_ID=local-reviewer
REVIEWER_DISPLAY_NAME=Local reviewer
REVIEWER_PASSWORD_HASH=
REVIEW_RATE_LIMIT_FINGERPRINT_SECRET=
REVIEW_SESSION_TTL_HOURS=8
REVIEW_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
REVIEW_ALLOW_INSECURE_LOOPBACK=true

# Safe automatic recovery: no unknown-call consent or automatic budget increase.
INVESTIGATION_AUTO_RESUME=true
INVESTIGATION_RECOVERY_SCAN_SECONDS=15
INVESTIGATION_AUTO_RESUME_MAX_ATTEMPTS=3
INVESTIGATION_AUTO_RESUME_BACKOFF_SECONDS=15
INVESTIGATION_STALL_HEARTBEAT_SECONDS=90
INVESTIGATION_STALL_STEP_SECONDS=900
